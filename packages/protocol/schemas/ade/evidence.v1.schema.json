{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestra ADE evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "source", "environment", "fixture_id", "generated_at", "overall_status", "scenarios"],
  "properties": {
    "report_version": { "const": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "tree_fingerprint"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "arch", "runtime_versions", "provider", "provider_version", "model", "tracker", "runtime_target"],
      "properties": {
        "os": { "$ref": "#/definitions/nonempty" },
        "arch": { "$ref": "#/definitions/nonempty" },
        "provider": { "$ref": "#/definitions/nonempty" },
        "provider_version": { "$ref": "#/definitions/nonempty" },
        "model": { "$ref": "#/definitions/nonempty" },
        "tracker": { "$ref": "#/definitions/nonempty" },
        "runtime_target": { "$ref": "#/definitions/nonempty" },
        "runtime_versions": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/nonempty" }
        }
      }
    },
    "fixture_id": { "$ref": "#/definitions/nonempty" },
    "generated_at": { "type": "string", "format": "date-time" },
    "overall_status": { "$ref": "#/definitions/status" },
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "mode", "boundaries", "artifacts", "duration_ms"],
        "properties": {
          "id": { "$ref": "#/definitions/nonempty" },
          "status": { "$ref": "#/definitions/status" },
          "mode": { "enum": ["simulated", "real"] },
          "boundaries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/nonempty" } },
          "artifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/nonempty" } },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "reason": { "$ref": "#/definitions/nonempty" },
          "task_id": { "$ref": "#/definitions/nonempty" },
          "run_id": { "$ref": "#/definitions/nonempty" },
          "attempt_id": { "$ref": "#/definitions/nonempty" },
          "session_id": { "$ref": "#/definitions/nonempty" },
          "tested_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    }
  },
  "definitions": {
    "nonempty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "enum": ["passed", "failed", "blocked", "skipped", "unsupported"] }
  }
}
